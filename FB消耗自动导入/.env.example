# Facebook Marketing API
FB_ACCESS_TOKEN=your_facebook_long_lived_token

# SmartBI 登录凭据
BI_USERNAME=your_bi_username
BI_PASSWORD=your_bi_password

# 钉钉机器人 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token

# SmartBI CLI 工具路径（可选，默认 D:\smartbi-data-cli）
SMARTBI_CLI_ROOT=D:\path\to\smartbi-data-cli
